# Python
__pycache__/
*.pyc

# Godot 4+ specific ignores
.godot/
/android/

# Freebuff local files
.freebuff/

# Editor local config
.vscode/

# System files
Thumbs.db
.DS_Store

# Runtime playtest raw logs (generated per run)
.ai/memory/runtime-logs/

# Runtime Self-Repair history (generated per repair round)
.ai/memory/runtime-repairs/

# Asset Bindings: Generated Data — 由 bind_assets / asset_repair / asset_nodes
# 随时重建，禁止手工维护。
.ai/context/asset_bindings/

# Asset Index: Generated Cache — 由 build_asset_index.py 随时重建，Source of Truth
# 是资源文件 + asset_manifest.yaml。--check 可验证：missing/stale/synchronized。
.ai/context/asset_index.json

# 测试运行工作区（Phase 1.32）：每次运行专属、所有权验证后清理；不承载任何源码/文档
.ai/tmp/

# godot-official-docs: local read-only official docs source snapshot (244MB)
# The navigation layer (references/4.7/) IS tracked; only the raw Source is ignored.
.ai/skills/godot-official-docs_sources/

# Run-tests evidence probes: generated per run at repo root by
# test_run_tests_evidence.py (self-cleaning; killed runs leave them behind)
run_tests_evidence_*/
