{
  "name": "godot-aiagent-build",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash .devcontainer/setup-godot.sh",
  "containerEnv": {
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "geequlim.godot-tools"
      ],
      "settings": {
        "godotTools.editorPath.godot4": "/usr/local/bin/godot",
        "files.eol": "\n"
      }
    }
  }
}
