{
  "name": "godot-aiagent-build",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup-godot.sh",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "geequlim.godot-tools"
      ],
      "settings": {
        "godotTools.editorPath.godot4": "/usr/local/bin/godot",
        "files.eol": "\n"
      }
    }
  }
}
