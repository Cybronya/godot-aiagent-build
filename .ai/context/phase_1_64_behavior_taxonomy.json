{
  "schema": "phase_1_64_behavior_taxonomy",
  "schema_version": 1,
  "categories": {
    "A": "State Transition",
    "B": "Event Propagation",
    "C": "Persistence",
    "D": "Resource Lifecycle",
    "E": "Interaction",
    "F": "Guard & Conditional Logic"
  },
  "score_inputs": {
    "impact": "1=纯反馈/书签记；2=可感知但可恢复；3=玩家可见错误结果或状态损坏",
    "state_risk": "1=单值单调变化；2=多步状态/时序；3=跨系统状态一致性（死亡/无敌/存档）",
    "data_loss": "0=不涉及持久化；3=存档写入/读取",
    "event_complexity": "1=无信号或单信号；2=1-2 个信号且有时序；3=多信号+条件广播/去重",
    "leak_risk": "0=无资源；1=瞬时对象；2=需显式释放的对象/池占用"
  },
  "formula": "risk = 2*impact + 2*state_risk + 3*data_loss + 1*event_complexity + 2*leak_risk + 2*gap(1-3) + (0 if readiness else 1)",
  "entries": [
    {"f": "attack_emitter", "b": "raycast_hit_deals_damage", "p": "E", "s": ["B"], "i": 3, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: raycast hit -> health.current 减少 + health_changed 信号；源码 raycast_attack_emitter.gd 命中后调用 take_damage"},
    {"f": "attack_emitter", "b": "repeated_attack_can_kill", "p": "A", "s": ["E"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 重复命中累积到 is_dead=true 且 died 信号；源码同一 raycast 路径"},
    {"f": "chase_movement", "b": "approach_target", "p": "A", "s": ["E"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: position/displacement 向 target 收敛；源码 _physics_process 写 velocity 并 move_and_slide"},
    {"f": "chase_movement", "b": "hold_without_target", "p": "F", "s": ["A"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: target 缺失時 displacement=0；源码 _physics_process 早退并置 velocity=0"},
    {"f": "collect_pickup", "b": "collect_on_contact", "p": "D", "s": ["E", "B"], "i": 3, "st": 2, "dl": 0, "ev": 2, "lk": 2, "basis": "contract: pickup.is_collected + node.freed + pickup.collected 信号；源码 _collect 内 queue_free"},
    {"f": "condition_gate", "b": "partial_conditions_block_output", "p": "F", "s": ["B"], "i": 3, "st": 2, "dl": 0, "ev": 3, "lk": 0, "basis": "contract: 只满足部分条件時 trigger/door 不变且无广播"},
    {"f": "condition_gate", "b": "all_conditions_fulfill", "p": "F", "s": ["B"], "i": 3, "st": 2, "dl": 0, "ev": 3, "lk": 0, "basis": "contract: 全部条件满足時 trigger.is_triggered=true 且 door.is_open=true + 信号"},
    {"f": "condition_gate", "b": "condition_fallback_withdraws_output", "p": "F", "s": ["B", "A"], "i": 3, "st": 2, "dl": 0, "ev": 3, "lk": 0, "basis": "contract: 条件撤回後输出回退（trigger/door 复位）"},
    {"f": "contact_damage", "b": "damage_on_contact", "p": "E", "s": ["A"], "i": 3, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 接触後 health.current 下降 + health_changed"},
    {"f": "contact_damage", "b": "no_damage_without_contact", "p": "F", "s": ["E"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 无接触時 current 不变且无信号（反向守卫）"},
    {"f": "contact_damage", "b": "damage_amount_is_respected", "p": "E", "s": ["A"], "i": 3, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 指定伤害量被精确应用（数值断言）"},
    {"f": "cooldown", "b": "cooldown_blocks_during_window", "p": "F", "s": ["A"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: is_ready 窗口内为 false 且不广播 ready"},
    {"f": "cooldown", "b": "cooldown_expires_and_notifies", "p": "A", "s": ["B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 到期後 is_ready=true 且广播 ready"},
    {"f": "cooldown", "b": "restart_resets_remaining_window", "p": "A", "s": ["F"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 重启重新计时（is_ready 再次 false）"},
    {"f": "heal_pickup", "b": "heal_damaged_target", "p": "E", "s": ["A", "D"], "i": 2, "st": 2, "dl": 0, "ev": 1, "lk": 1, "basis": "contract: 接触後 health.current 回升且 node.freed"},
    {"f": "health", "b": "damage", "p": "A", "s": ["B"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: current 精确减少 + health_changed last_args"},
    {"f": "health", "b": "heal_clamped", "p": "A", "s": ["F"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 治疗被钳到 max + last_args=[5,99]"},
    {"f": "health", "b": "death", "p": "A", "s": ["B"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: current=0、is_dead=true、died 信号 1 次"},
    {"f": "health", "b": "overkill_clamps_at_zero", "p": "F", "s": ["A"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 100 点过杀仍停在 0（下限钳制）"},
    {"f": "health", "b": "post_death_guard", "p": "F", "s": ["A"], "i": 3, "st": 3, "dl": 0, "ev": 3, "lk": 0, "basis": "contract: 死後扣血/治疗均被守卫拒绝（current/信号/重复 died 三处可观测）"},
    {"f": "health_bar", "b": "initial_health_bar_ratio", "p": "A", "s": ["B"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 初始 ratio 与 current 一致"},
    {"f": "health_bar", "b": "damage_updates_health_bar", "p": "A", "s": ["B"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 受伤後 ratio 同步下降 + 信号"},
    {"f": "health_bar", "b": "healing_updates_health_bar", "p": "A", "s": ["B"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 治疗後 ratio 回升 + 信号"},
    {"f": "health_bar", "b": "death_empties_health_bar", "p": "A", "s": ["B"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 死亡後 ratio=0"},
    {"f": "health_bar", "b": "unbound_bar_reports_no_fill", "p": "F", "s": ["A"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 未绑定目标時 ratio 保持 0（不得 crash/假填充）"},
    {"f": "hit_flash", "b": "hit_flashes_host", "p": "B", "s": ["A"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 受伤广播 flash(true) 且宿主可见态改变"},
    {"f": "hit_flash", "b": "flash_ends_after_duration", "p": "A", "s": ["B"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 时长後广播 flash(false) 且恢复"},
    {"f": "hit_flash", "b": "heal_does_not_flash", "p": "F", "s": ["B"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 治疗不触发闪烁（反向守卫）"},
    {"f": "i_frames", "b": "iframes_block_damage_within_window", "p": "F", "s": ["A"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 无敌窗口内 current 不变、无 health_changed"},
    {"f": "i_frames", "b": "iframes_expire_and_damage_resumes", "p": "A", "s": ["F"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 窗口过後伤害恢复生效"},
    {"f": "i_frames", "b": "killing_blow_still_dies", "p": "F", "s": ["A"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 无敌不豁免致死判定（is_dead=true）"},
    {"f": "knockback", "b": "knockback_applies_and_signals", "p": "B", "s": ["A"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 位移脉冲 + knockback_changed(true)（幂等不重复）"},
    {"f": "knockback", "b": "knockback_decays_to_rest", "p": "A", "s": ["B"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 线性衰减至静止 + knockback_changed(false)"},
    {"f": "knockback", "b": "knockback_rejects_invalid", "p": "F", "s": ["B"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 零方向/非正力被拒绝且无广播"},
    {"f": "moving_platform", "b": "travel", "p": "A", "s": ["E"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 平台/乘客位移随时间推进"},
    {"f": "moving_platform", "b": "round_trip", "p": "A", "s": ["E"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 往返（三角波）回到起点附近"},
    {"f": "openable_door", "b": "open", "p": "A", "s": ["B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: is_open 变 true + door.state_changed 信号"},
    {"f": "patrol_movement", "b": "loop_patrol_cycles_waypoints", "p": "A", "s": ["B"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 循环模式重复广播 waypoint_reached"},
    {"f": "patrol_movement", "b": "outbound_leg_moves_at_constant_speed", "p": "A", "s": ["E"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 单段位移与速度/帧数一致"},
    {"f": "patrol_movement", "b": "ping_pong_reverses_at_path_end", "p": "A", "s": ["F"], "i": 2, "st": 1, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 往返模式端点折返（方向反转）"},
    {"f": "player_movement", "b": "move_right", "p": "E", "s": ["A"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 输入按下 → displacement 向右"},
    {"f": "player_movement", "b": "stop_on_release", "p": "E", "s": ["F"], "i": 2, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: 松开输入 → 位移归零"},
    {"f": "projectile", "b": "in_flight_moves_until_lifetime", "p": "A", "s": ["D"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 1, "basis": "contract: 存活期内持续位移、未提前释放"},
    {"f": "projectile", "b": "lifetime_expiry_frees_projectile", "p": "D", "s": ["A"], "i": 3, "st": 2, "dl": 0, "ev": 2, "lk": 2, "basis": "contract: 生命周期到期释放节点 + 信号"},
    {"f": "projectile", "b": "hit_deals_damage_and_expires", "p": "E", "s": ["D", "A"], "i": 3, "st": 2, "dl": 0, "ev": 3, "lk": 2, "basis": "contract: 命中造成伤害且自身释放（一次性）"},
    {"f": "save_game", "b": "save_slot_persists_world_state", "p": "C", "s": ["A"], "i": 3, "st": 3, "dl": 3, "ev": 2, "lk": 0, "basis": "contract: 存档槽写入 current 与 last_slot（跨 run 持久化）"},
    {"f": "save_game", "b": "load_slot_restores_world_state", "p": "C", "s": ["A"], "i": 3, "st": 3, "dl": 3, "ev": 2, "lk": 0, "basis": "contract: 读档回填 current（跨 run 恢复）"},
    {"f": "screen_shake", "b": "trauma_starts_shake", "p": "B", "s": ["A"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: add_trauma 广播 shaking(true)"},
    {"f": "screen_shake", "b": "shake_stops_after_decay", "p": "A", "s": ["B"], "i": 1, "st": 1, "dl": 0, "ev": 1, "lk": 0, "basis": "contract: trauma 衰减到 0 广播 shaking(false)"},
    {"f": "sfx_pool", "b": "sfx_play_emits_and_occupies", "p": "D", "s": ["B"], "i": 1, "st": 1, "dl": 0, "ev": 2, "lk": 1, "basis": "contract: play 同步广播 played 且 active_count 增加"},
    {"f": "sfx_pool", "b": "sfx_pool_steals_oldest_when_full", "p": "D", "s": ["A"], "i": 1, "st": 1, "dl": 0, "ev": 2, "lk": 1, "basis": "contract: 池满时抢占最旧，active_count 不超上限"},
    {"f": "state_machine", "b": "transition_to_named_state", "p": "A", "s": ["B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: current_state_name 改变 + state_changed"},
    {"f": "state_machine", "b": "previous_backtracks_via_history", "p": "A", "s": ["F"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: previous() 按历史栈回退（空历史有守卫）"},
    {"f": "stun", "b": "hit_stuns_and_freezes_host", "p": "A", "s": ["E", "B"], "i": 3, "st": 3, "dl": 0, "ev": 3, "lk": 0, "basis": "contract: 受击後位移冻结 + stun 信号 + health 变化"},
    {"f": "stun", "b": "stun_expires_and_host_resumes", "p": "A", "s": ["B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 眩晕到期恢复移动 + 信号"},
    {"f": "stun", "b": "heal_does_not_stun", "p": "F", "s": ["B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 治疗不触发眩晕（反向守卫）"},
    {"f": "stun", "b": "death_guard_rejects_stun", "p": "F", "s": ["A"], "i": 3, "st": 3, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 死亡後不再进入眩晕（is_dead 守卫）"},
    {"f": "stun", "b": "reentry_extends_without_rebroadcast", "p": "F", "s": ["B", "A"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 重复命中延长时长但不重复广播 stun(true)"},
    {"f": "trigger_switch", "b": "latch_once", "p": "F", "s": ["A", "B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 第一次接触锁存，第二次无新广播"},
    {"f": "trigger_switch", "b": "toggle_on_second_contact", "p": "A", "s": ["F", "B"], "i": 2, "st": 2, "dl": 0, "ev": 2, "lk": 0, "basis": "contract: 第二次接触翻转状态 + 广播"}
  ]
}
